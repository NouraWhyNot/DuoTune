<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permissions on purpose: DuoTune has no internet access and no root of its own. -->
    <application android:label="DuoTune" android:icon="@drawable/ic_launcher" android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ScreenActivity" android:exported="false" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"/>
    </application>
</manifest>
